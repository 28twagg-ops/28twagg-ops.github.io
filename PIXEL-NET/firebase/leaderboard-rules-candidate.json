{
  "rules": {
    ".read": false,
    ".write": false,
    "lb": {
      "$game": {
        ".read": true,
        "$entry": {
          ".write": "auth != null && !data.exists() && newData.exists() && $entry.matches(/^[-A-Za-z0-9_]{10,80}$/) && ($game === 'neon-chase' || $game === 'millipede-chaos' || $game === 'spyder-blackjack' || $game === 'spyder-holdem' || $game === 'astrotype' || $game === 'galaxy-swarm-2084' || $game === 'circuit-salvager' || $game === 'atariforce-hyperlane' || $game === 'kangaroo-climb' || $game === 'caked-up-cats' || $game === 'spyder-casino' || $game === 'space-invaders' || $game === 'pacman')",
          ".validate": "newData.hasChildren(['initials','score','t']) && newData.childrenCount <= 4",
          "initials": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{1,3}$/)" },
          "score": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000 && newData.val() % 1 === 0" },
          "t": { ".validate": "newData.isNumber() && newData.val() >= now - 300000 && newData.val() <= now + 300000" },
          "mode": { ".validate": "newData.isString() && (newData.val() === 'STANDARD' || newData.val() === 'ANALYSIS')" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}